HOST=127.0.0.1
PORT=3800
DATABASE_PATH=./data/shooting-operations.sqlite
BACKUP_DIRECTORY=./data/backups
UPLOAD_ROOT=./data/uploads

# Generate independent random values during deployment. Do not commit real values.
VIEWER_TOKEN=replace-with-random-viewer-token
SUBMITTER_TOKEN=replace-with-random-submitter-token
SCHEDULER_TOKEN=replace-with-random-scheduler-token
ADMIN_TOKEN=replace-with-random-admin-token

# Keep disabled during greenfield pre-activation acceptance; enable only in the authorized activation transition.
WRITE_ADMISSION_MODE=enabled
ORPHAN_CLEANUP_MODE=inherit

# Opt-in public read-only Jenn board; exposes scheduled customer details and associated images.
# Requires the corresponding image/source and existing R4 runtime configuration binding.
JSO_PUBLIC_BOARD=disabled
