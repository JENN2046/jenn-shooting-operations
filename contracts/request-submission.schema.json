{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jenn.local/contracts/request-submission-v1.schema.json",
  "title": "Jenn Shooting Request Submission v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operationId", "productionType", "sku", "name", "kind", "shootingSubtype", "aspectRatio", "deliver", "requestedBy"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "operationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
    },
    "productionType": { "enum": ["平面", "视频"] },
    "sku": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S" },
    "name": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "\\S" },
    "kind": { "enum": ["模特", "细节", "场景", "待定"] },
    "shootingSubtype": { "enum": ["模特", "细节", "场景", "待定", "产品展示", "人物展示", "产品加人物展示"] },
    "deliverableCount": { "type": "integer", "minimum": 1, "maximum": 999 },
    "aspectRatio": { "enum": ["待定", "1:1", "3:4", "4:5", "9:16", "16:9"] },
    "deliver": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" },
    "requestedBy": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\S" },
    "desiredDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "note": { "type": "string", "maxLength": 2000 },
    "uploadIds": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9-]{8,160}$"
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "productionType": { "const": "平面" } } },
      "then": {
        "properties": { "shootingSubtype": { "enum": ["模特", "细节", "场景", "待定"] } }
      }
    },
    {
      "if": { "properties": { "productionType": { "const": "视频" } } },
      "then": {
        "properties": {
          "shootingSubtype": { "enum": ["产品展示", "人物展示", "产品加人物展示"] },
          "deliverableCount": false
        }
      }
    }
  ]
}
