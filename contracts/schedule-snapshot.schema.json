{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jenn.local/contracts/schedule-snapshot-v1.schema.json",
  "title": "Jenn Shooting Schedule Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "revision",
    "updatedAt",
    "products",
    "tasks",
    "sessions"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "products": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          { "type": "string", "minLength": 1, "maxLength": 120 },
          { "type": "string", "minLength": 1, "maxLength": 240 }
        ],
        "items": false
      }
    },
    "tasks": {
      "type": "array",
      "items": { "$ref": "#/$defs/task" }
    },
    "sessions": {
      "type": "array",
      "items": { "$ref": "#/$defs/session" }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sku", "name", "client", "deliver", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "sku": { "type": "string", "minLength": 1, "maxLength": 120 },
        "name": { "type": "string", "minLength": 1, "maxLength": 240 },
        "client": { "type": "string", "minLength": 1, "maxLength": 160 },
        "deliver": { "type": "string", "minLength": 1, "maxLength": 500 },
        "kind": { "enum": ["模特", "细节", "场景", "待定"] },
        "status": { "enum": ["pending", "scheduled", "completed", "cancelled"] },
        "source": { "enum": ["workbench", "submission", "import"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "assets": {
          "type": "array",
          "maxItems": 10,
          "items": { "$ref": "#/$defs/asset" }
        },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["productionType", "shootingSubtype", "aspectRatio", "requestedBy", "desiredDate", "note"],
          "properties": {
            "productionType": { "enum": ["平面", "视频"] },
            "shootingSubtype": { "enum": ["模特", "细节", "场景", "产品展示", "人物展示", "产品加人物展示", "口播", "剧情短片", "场景视频", "待定"] },
            "deliverableCount": { "type": "integer", "minimum": 1, "maximum": 999 },
            "aspectRatio": { "enum": ["待定", "1:1", "3:4", "4:5", "9:16", "16:9"] },
            "durationSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
            "audioRequirement": { "enum": ["待定", "原声", "配音", "音乐", "无声"] },
            "requestedBy": { "type": "string", "minLength": 1, "maxLength": 160 },
            "desiredDate": {
              "type": "string",
              "pattern": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "note": { "type": "string", "maxLength": 2000 }
          }
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "contentType", "kind", "size", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 8, "maxLength": 160 },
        "name": { "type": "string", "minLength": 1, "maxLength": 240 },
        "contentType": { "type": "string", "minLength": 1, "maxLength": 120 },
        "kind": { "enum": ["image", "attachment"] },
        "size": { "type": "integer", "minimum": 1, "maximum": 20971520 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ids", "date", "start", "end", "place", "note"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "start": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
        "end": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
        "place": { "type": "string", "maxLength": 300 },
        "note": { "type": "string", "maxLength": 2000 },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
