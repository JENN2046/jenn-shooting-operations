{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jenn.local/contracts/legacy-compat-fragment-v2.schema.json",
  "title": "Jenn Shooting Legacy Compatibility Fragment v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entity_type", "entity_id", "json_pointer", "value_json", "value_digest",
    "violation_code", "classification", "mapping_version", "source_ordinal"
  ],
  "properties": {
    "entity_type": { "enum": ["root", "task", "session", "request", "asset"] },
    "entity_id": { "type": ["string", "null"], "minLength": 1, "maxLength": 160 },
    "json_pointer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^(?:/(?:[^~/]|~[01])*)+$"
    },
    "value_json": { "type": "string", "minLength": 1, "maxLength": 100000 },
    "value_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "violation_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,127}$" },
    "classification": { "const": "L1_GRANDFATHERED_OPAQUE" },
    "mapping_version": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\S" },
    "source_ordinal": { "type": "integer", "minimum": 0 }
  },
  "allOf": [
    {
      "if": { "properties": { "entity_type": { "const": "root" } }, "required": ["entity_type"] },
      "then": { "properties": { "entity_id": { "type": "null" } } },
      "else": { "properties": { "entity_id": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\S" } } }
    }
  ]
}
