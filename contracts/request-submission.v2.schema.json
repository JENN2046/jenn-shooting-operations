{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jenn.local/contracts/request-submission-v2.schema.json",
  "title": "Jenn Shooting Request Submission v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "operationId", "productionType", "sku", "name", "kind",
    "shootingSubtype", "aspectRatio", "deliverables", "requestedBy", "desiredDate",
    "note", "coreBriefSummary", "sampleStatus", "lightingPreset", "reflectivity", "priority", "uploadIds"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "operationId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$" },
    "productionType": { "enum": ["平面", "视频"] },
    "sku": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S" },
    "name": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "\\S" },
    "kind": { "enum": ["模特", "细节", "场景", "待定"] },
    "shootingSubtype": {
      "enum": ["模特", "细节", "场景", "待定", "产品展示", "人物展示", "产品加人物展示", "口播", "剧情短片", "场景视频"]
    },
    "aspectRatio": { "enum": ["待定", "1:1", "3:4", "4:5", "9:16", "16:9"] },
    "deliverables": {
      "oneOf": [
        { "$ref": "#/$defs/flatDeliverables" },
        { "$ref": "#/$defs/videoDeliverables" }
      ]
    },
    "requestedBy": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\S" },
    "desiredDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "note": { "type": "string", "maxLength": 2000 },
    "coreBriefSummary": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "\\S" },
    "briefUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "heroAssetId": { "type": "string", "minLength": 8, "maxLength": 160, "pattern": "\\S" },
    "sampleStatus": { "enum": ["arrivedVerified", "inTransit", "unavailable"] },
    "sampleShelfId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\S" },
    "lightingPreset": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S" },
    "reflectivity": { "enum": ["unknown", "low", "medium", "high"] },
    "priority": { "enum": ["p0", "p1", "p2"] },
    "uploadIds": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9-]{8,160}$" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "productionType": { "const": "平面" } }, "required": ["productionType"] },
      "then": {
        "properties": {
          "shootingSubtype": { "enum": ["模特", "细节", "场景", "待定"] },
          "deliverables": { "$ref": "#/$defs/flatDeliverables" }
        }
      }
    },
    {
      "if": { "properties": { "productionType": { "const": "视频" } }, "required": ["productionType"] },
      "then": {
        "properties": {
          "shootingSubtype": { "enum": ["产品展示", "人物展示", "产品加人物展示", "口播", "剧情短片", "场景视频"] },
          "deliverables": { "$ref": "#/$defs/videoDeliverables" }
        }
      }
    }
  ],
  "$defs": {
    "flatDeliverables": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "count"],
      "properties": {
        "type": { "const": "flat" },
        "count": { "type": "integer", "minimum": 1, "maximum": 999 }
      }
    },
    "videoDeliverables": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "durationSeconds", "audioRequirement"],
      "properties": {
        "type": { "const": "video" },
        "durationSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "audioRequirement": { "enum": ["待定", "原声", "配音", "音乐", "无声"] }
      }
    }
  }
}
